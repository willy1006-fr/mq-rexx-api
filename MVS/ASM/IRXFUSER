***********************************************************************
*        extern "OS" int RXSAY (char*, int);                          *
***********************************************************************
RXSAY    TITLE 'Assembler stub for REXX IRXSAY function'
RXSAY    CSECT
RXSAY    AMODE 31
RXSAY    RMODE ANY
         EDCPRLG
*
         L     15,àSAVEEB    à à Envblock
         L     15,0(,15)     à Envblock
         MVC   àSAYSTR,0(1)  à string
         L     1,4(,1)       à length
         LA    1,0(,1)       clear high order bit
         ST    1,PLSAY+8     à length -> plist
         LA    1,PLSAY       à plist for IRXSAY
         USING ENVBLOCK,15
         L     15,ENVBLOCK_IRXEXTE     à Irxexte
         DROP  15
         USING IRXEXTE,15
         L     15,IRXSAY               à IRXSAY
         DROP  15
         BALR  14,15
*
         EDCEPIL
*
PLSAY    DS    0F
         DC    A(FNNAME)     à 'WRITE'
         DC    A(àSAYSTR)    à à string
         DC    A(0)          à length
àSAVEEB  DC    V(SAVEEB)     à envblock
         DC    A(RETCODE+X'80000000')
FNNAME   DC    CL8'WRITE'
àSAYSTR  DC    A(0)          à string
RETCODE  DC    F'0'
*
         LTORG
         IRXENVB             Environment block
         IRXEXTE             External Entry Points
         END
***********************************************************************
*        extern "OS" int RXEXCOM (struct shvblock_mvs_t*);            *
***********************************************************************
RXEXCOM  TITLE 'Assembler stub for REXX IRXEXCOM function'
RXEXCOM  CSECT
RXEXCOM  AMODE 31
RXEXCOM  RMODE ANY
         EDCPRLG
*
         L     15,àSAVEEB    à à Envblock
         L     15,0(15)      à Envblock
         L     1,0(,1)       à Shvblock
         LA    1,0(,1)       clear high order bit
         ST    1,PLEXCOM+12  à Shvblock -> plist
         LA    1,PLEXCOM     à plist for IRXEXCOM
         USING ENVBLOCK,15
         L     15,ENVBLOCK_IRXEXTE     à Irxexte
         DROP  15
         USING IRXEXTE,15
         L     15,IRXEXCOM             à IRXEXCOM
         DROP  15
         BALR  14,15
*
         EDCEPIL
*
PLEXCOM  DS    0F
         DC    A(EXNAME)     à 'IRXEXCOM'
         DC    A(0)          must be 0
         DC    A(0)          must be 0
         DC    A(0)          à MVS shvblock
àSAVEEB  DC    V(SAVEEB)     à envblock
         DC    A(RETCODE+X'80000000')
EXNAME   DC    CL8'IRXEXCOM'
RETCODE  DC    F'0'
*
         LTORG
         IRXENVB             Environment block
         IRXEXTE             External Entry Points
         END
