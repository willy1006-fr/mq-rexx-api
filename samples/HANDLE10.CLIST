/* REXX */
/*
 * HANDLE10 - Selection de messages avec MQOD.SelectionString
 *
 * Ce sample cree cinq messages dans la meme file. Chaque message porte :
 *
 *   usr.testid : identifiant unique de cette execution
 *   usr.color  : BLUE, RED ou GREEN
 *   usr.site   : PARIS, LYON ou LILLE
 *
 * Deux demonstrations sont ensuite effectuees :
 *
 *   1. Selection par proprietes :
 *        usr.testid = '<runid>' AND usr.color = 'BLUE'
 *      Deux messages doivent etre recuperes.
 *
 *   2. Selection combinee MsgId + proprietes :
 *        Root.MQMD.MsgId = "0x..."
 *        AND usr.testid = '<runid>'
 *        AND usr.color = 'RED'
 *      Un seul message precis doit etre recupere.
 *
 * Les messages restants de cette execution sont ensuite supprimes avec
 * un dernier selecteur usr.testid = '<runid>'.
 */

trace o

qmgr  = 'QM1'
qname = 'DEV.QUEUE.1'
runid = 'SEL' || date('S') || right(time('S'),5,'0')

connecte = 0
hputouvert = 0
hselouvert = 0
mhcree = 0
mhputcree = 0
rcode = 0
firstFailure = ''

say '============================================================'
say 'HANDLE10 - TEST DES SELECTEURS MQ'
say 'QMGR  =' qmgr
say 'QUEUE =' qname
say 'RUNID =' runid
say '============================================================'
say ''

/* --------------------------------------------------------------- */
/* Initialisation et connexion                                     */
/* --------------------------------------------------------------- */
rcc = RXMQINIT()
say 'INIT =' rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end

rcc = RXMQCONN(qmgr)
say 'CONN =' rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
connecte = 1

/* --------------------------------------------------------------- */
/* Ouverture de la file en sortie                                  */
/* --------------------------------------------------------------- */
drop iodput. oodput.
iodput.VER = MQOD_VERSION_4
iodput.OT  = MQOT_Q
iodput.ON  = qname

openput = MQOO_OUTPUT + MQOO_FAIL_IF_QUIESCING
rcc = RXMQOPEN('iodput.',openput,'hput','oodput.')
say 'OPEN sortie =' rcc ' hput=' hput
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
hputouvert = 1

/* --------------------------------------------------------------- */
/* Creation des cinq messages                                      */
/* --------------------------------------------------------------- */
say ''
say 'Creation des messages'
say '----------------------------------------------'

call putmessage 1, 'BLUE',  'PARIS', 'Message 1 : BLUE PARIS'
if rcode <> 0 then signal cleanup

call putmessage 2, 'RED',   'LYON',  'Message 2 : RED LYON'
if rcode <> 0 then signal cleanup

call putmessage 3, 'BLUE',  'LILLE', 'Message 3 : BLUE LILLE'
if rcode <> 0 then signal cleanup

call putmessage 4, 'GREEN', 'PARIS', 'Message 4 : GREEN PARIS'
if rcode <> 0 then signal cleanup

/* Ce cinquieme message sera ensuite cible par son MsgId exact. */
call putmessage 5, 'RED',   'PARIS', 'Message 5 : RED PARIS cible MsgId'
if rcode <> 0 then signal cleanup

targetmsgid    = msgid5
targetmsgidhex = c2x(targetmsgid)

say ''
say 'MsgId cible du message 5 = 0x' || targetmsgidhex

/* Le handle de PUT n'est plus necessaire. */
rcc = RXMQCLOS(hput,MQCO_NONE)
say 'CLOSE sortie =' rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
hputouvert = 0

/* =============================================================== */
/* TEST 1 - Selection par proprietes                               */
/* =============================================================== */
say ''
say '============================================================'
say 'TEST 1 - SELECTION PAR PROPRIETES'
say '============================================================'

selector1 = "usr.testid = '" || runid ||,
            "' AND usr.color = 'BLUE'"

say 'Selecteur = ' selector1

call openselector selector1
if rcode <> 0 then signal cleanup

count1 = 0
call createmh
if rcode <> 0 then signal cleanup

do forever
   call getselected 1000
   if rcode <> 0 then signal cleanup

   if getend = 1 then leave
   if getrc <> 0 then do
      call showerr rcc
      rcode = 8
      signal cleanup
   end

   count1 = count1 + 1
   call showproperties
   if rcode <> 0 then signal cleanup
end

call deletemh
call closeselector
if rcode <> 0 then signal cleanup

say 'Nombre de messages BLUE recuperes =' count1
if count1 = 2 then
   say 'TEST 1 OK : exactement deux messages selectionnes'
else do
   say 'TEST 1 ERREUR : attendu 2, obtenu' count1
   if firstFailure = '' then
      firstFailure = 'Selection BLUE : nombre de messages inattendu'
   rcode = 8
   signal cleanup
end

/* =============================================================== */
/* TEST 2 - Selection combinee MsgId + proprietes                  */
/* =============================================================== */
say ''
say '============================================================'
say 'TEST 2 - SELECTION MsgId + PROPRIETES'
say '============================================================'

selector2 = 'Root.MQMD.MsgId = "0x' || targetmsgidhex ||,
            '" AND usr.testid = ''' || runid ||,
            ''' AND usr.color = ''RED'''

say 'Selecteur = ' selector2

call openselector selector2
if rcode <> 0 then signal cleanup

call createmh
if rcode <> 0 then signal cleanup

call getselected 3000
if rcode <> 0 then signal cleanup
if getrc <> 0 then do
   call showerr rcc
   say 'TEST 2 ERREUR : le message cible n a pas ete trouve'
   rcode = 8
   signal cleanup
end

say 'Message cible recupere'
say 'MsgId recu = 0x' || c2x(ogmd.MSGID)
call showproperties
if rcode <> 0 then signal cleanup

if c2x(ogmd.MSGID) <> targetmsgidhex then do
   say 'TEST 2 ERREUR : MsgId different du MsgId cible'
   if firstFailure = '' then firstFailure = 'MsgId cible incorrect'
   rcode = 8
   signal cleanup
end

/* Un second GET ne doit rien trouver pour ce selecteur exact. */
call getselected 1000
if rcode <> 0 then signal cleanup
if getend = 1 then
   say 'Aucun second message : OK'
else do
   say 'TEST 2 ERREUR : plusieurs messages correspondent au MsgId'
   if firstFailure = '' then
      firstFailure = 'Plusieurs messages pour le MsgId cible'
   rcode = 8
   signal cleanup
end

call deletemh
call closeselector
if rcode <> 0 then signal cleanup
say 'TEST 2 OK : un seul message precis selectionne'

/* =============================================================== */
/* NETTOYAGE - suppression des messages restants de cette execution */
/* =============================================================== */
say ''
say '============================================================'
say 'NETTOYAGE DES MESSAGES RESTANTS'
say '============================================================'

selector3 = "usr.testid = '" || runid || "'"
say 'Selecteur = ' selector3

call openselector selector3
if rcode <> 0 then signal cleanup

call createmh
if rcode <> 0 then signal cleanup

reste = 0
do forever
   call getselected 500
   if rcode <> 0 then signal cleanup
   if getend = 1 then leave
   if getrc <> 0 then do
      call showerr rcc
      rcode = 8
      signal cleanup
   end
   reste = reste + 1
   say 'Message restant supprime :' msg.1
end

call deletemh
call closeselector
if rcode <> 0 then signal cleanup
say 'Nombre de messages restants supprimes =' reste

signal cleanup

/* ================================================================= */
/* Sous-programme : creation et PUT d'un message                     */
/* ================================================================= */
putmessage:
   parse arg numero, couleur, site, corps

   drop cmho. smpo. pd. imd. omd. ipmo. opmo. data.

   cmho.OPT = MQCMHO_VALIDATE
   rcc = RXMQMH('mhput','cmho.')
   if word(rcc,1) <> 0 then do
      call showerr rcc
      say 'MQCRTMH erreur =' rcc
      rcode = 8
      return
   end
   mhputcree = 1

   smpo.OPT       = MQSMPO_NONE
   pd.VER         = MQPD_VERSION_1
   pd.OPT         = MQPD_NONE
   pd.SUPPORT     = MQPD_SUPPORT_OPTIONAL
   pd.CONTEXT     = MQPD_NO_CONTEXT
   pd.COPYOPTIONS = MQCOPY_NONE

   rcc = RXMQSMP('mhput','smpo.','usr.testid','pd.',MQTYPE_STRING,runid)
   if word(rcc,1) <> 0 then do
      call showerr rcc
      say 'SET usr.testid erreur =' rcc
      rcode = 8
      signal putmessage_cleanup
   end

   rcc = RXMQSMP('mhput','smpo.','usr.color','pd.',MQTYPE_STRING,couleur)
   if word(rcc,1) <> 0 then do
      call showerr rcc
      say 'SET usr.color erreur =' rcc
      rcode = 8
      signal putmessage_cleanup
   end

   rcc = RXMQSMP('mhput','smpo.','usr.site','pd.',MQTYPE_STRING,site)
   if word(rcc,1) <> 0 then do
      call showerr rcc
      say 'SET usr.site erreur =' rcc
      rcode = 8
      signal putmessage_cleanup
   end

   rcc = RXMQSMP('mhput','smpo.','usr.numero','pd.',MQTYPE_INT32,numero)
   if word(rcc,1) <> 0 then do
      call showerr rcc
      say 'SET usr.numero erreur =' rcc
      rcode = 8
      signal putmessage_cleanup
   end

   data.1 = corps
   data.0 = length(data.1)

   imd.VER   = MQMD_VERSION_2
   imd.REP   = MQRO_NONE
   imd.MSG   = MQMT_DATAGRAM
   imd.EXP   = MQEI_UNLIMITED
   imd.FBK   = MQFB_NONE
   imd.ENC   = MQENC_NATIVE
   imd.CCSI  = MQCCSI_Q_MGR
   imd.FORM  = MQFMT_STRING
   imd.PRI   = MQPRI_PRIORITY_AS_Q_DEF
   imd.PER   = MQPER_PERSISTENCE_AS_Q_DEF
   imd.MSGID = MQMI_NONE
   imd.CID   = MQCI_NONE

   ipmo.VER  = MQPMO_VERSION_3
   ipmo.OPT  = MQPMO_NO_SYNCPOINT +,
               MQPMO_FAIL_IF_QUIESCING +,
               MQPMO_NEW_MSG_ID +,
               MQPMO_DEFAULT_CONTEXT
   ipmo.OMH  = MQHM_NONE
   ipmo.NMH  = mhput
   ipmo.ACT  = MQACTP_NEW

   rcc = RXMQPUT(hput,'data.','imd.','omd.','ipmo.','opmo.')
   say 'PUT' numero couleur site '=' rcc
   if word(rcc,1) <> 0 then do
      call showerr rcc
      rcode = 8
      signal putmessage_cleanup
   end

   say '  Corps = ' corps
   say '  MsgId = 0x' || c2x(omd.MSGID)

   if numero = 5 then msgid5 = omd.MSGID

putmessage_cleanup:
   call deleteputmh
   return

deleteputmh:
   if mhputcree = 1 then do
      dmho.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mhput','dmho.')
      say "DMH PUT =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else mhputcree = 0
   end
   return

/* ================================================================= */
/* Sous-programme : ouverture avec MQOD.SelectionString              */
/* ================================================================= */
openselector:
   parse arg selecteur

   drop iodsel. oodsel.
   iodsel.VER = MQOD_VERSION_4
   iodsel.OT  = MQOT_Q
   iodsel.ON  = qname

   /* MQCHARV SelectionString represente par le sous-stem SS. */
   iodsel.SS.0    = length(selecteur)
   iodsel.SS.1    = selecteur
   iodsel.SS.CCSI = MQCCSI_APPL

   openin = MQOO_INPUT_SHARED + MQOO_FAIL_IF_QUIESCING
   rcc = RXMQOPEN('iodsel.',openin,'hsel','oodsel.')
   say 'OPEN selecteur =' rcc ' hsel=' hsel
   if word(rcc,1) <> 0 then do
      call showerr rcc
      rcode = 8
      return
   end
   hselouvert = 1
   return

/* ================================================================= */
/* Sous-programme : fermeture du handle avec selecteur               */
/* ================================================================= */
closeselector:
   if hselouvert = 1 then do
      rcc = RXMQCLOS(hsel,MQCO_NONE)
      say 'CLOSE selecteur =' rcc
      if word(rcc,1) <> 0 then do
        call showerr rcc
         rcode = 8
      end
      else hselouvert = 0
   end
   return

/* ================================================================= */
/* Sous-programme : creation du message handle de GET                */
/* ================================================================= */
createmh:
   drop cmhoget.
   cmhoget.OPT = MQCMHO_VALIDATE
   rcc = RXMQMH('mhget','cmhoget.')
   say 'MH GET =' rcc ' mhget=' mhget
   if word(rcc,1) <> 0 then do
      call showerr rcc
      rcode = 8
      return
   end
   mhcree = 1
   return

/* ================================================================= */
/* Sous-programme : suppression du message handle de GET             */
/* ================================================================= */
deletemh:
   if mhcree = 1 then do
      dmho.OPT = MQDMHO_NONE
      rcc = RXMQDMH('mhget','dmho.')
      say 'DMH GET =' rcc
      if word(rcc,1) <> 0 then do
         call showerr rcc
         rcode = 8
      end
      else mhcree = 0
   end
   return

/* ================================================================= */
/* Sous-programme : GET d'un message correspondant au selecteur      */
/* ================================================================= */
getselected:
   parse arg attente

   drop msg. igmd. ogmd. igmo. ogmo.
   msg.0 = 8192

   igmd.VER   = MQMD_VERSION_2
   igmd.ENC   = MQENC_NATIVE
   igmd.CCSI  = MQCCSI_Q_MGR
   igmd.FORM  = MQFMT_NONE
   igmd.MSGID = MQMI_NONE
   igmd.CID   = MQCI_NONE

   igmo.VER  = MQGMO_VERSION_4
   igmo.OPT  = MQGMO_NO_SYNCPOINT +,
               MQGMO_WAIT +,
               MQGMO_FAIL_IF_QUIESCING +,
               MQGMO_PROPERTIES_IN_HANDLE
   igmo.WAIT = attente
   igmo.MOPT = MQMO_NONE
   igmo.MH   = mhget

   rcc = RXMQGET(hsel,'msg.','igmd.','ogmd.','igmo.','ogmo.')
   getrc     = word(rcc,1)
   getcc     = RXMQ.LASTCC
   getreason = RXMQ.LASTAC
   getend = (getrc = MQCC_FAILED & getcc = MQCC_FAILED &,
             getreason = MQRC_NO_MSG_AVAILABLE)

   if getrc = 0 then do
      say 'GET =' rcc
      say '  Corps = ' msg.1
   end
   else if getend = 0 then do
      call showerr rcc
      rcode = 8
   end
   return

/* ================================================================= */
/* Sous-programme : affichage des proprietes du message selectionne  */
/* ================================================================= */
showproperties:
   call inqstring 'usr.testid', 'testid'
   call inqstring 'usr.color',  'color'
   call inqstring 'usr.site',   'site'
   call inqstring 'usr.numero', 'numero'

   say '  MsgId      = 0x' || c2x(ogmd.MSGID)
   say '  usr.testid =' testid
   say '  usr.color  =' color
   say '  usr.site   =' site
   say '  usr.numero =' numero
   say '----------------------------------------------'
   return

/* ================================================================= */
/* Sous-programme : lecture d'une propriete dans le message handle   */
/* ================================================================= */
inqstring:
   parse arg propname, resultname

   drop impo. pdout. pvalue.
   impo.OPT    = MQIMPO_INQ_FIRST
   impo.RQENC  = MQENC_NATIVE
   impo.RQCCSI = MQCCSI_APPL
   pvalue.0    = 4096
   pnameout    = ''
   ptype       = 0

   rcc = RXMQIMP('mhget','impo.',propname,'pdout.',,
                 'ptype','pvalue.','pnameout')
   if word(rcc,1) = 0 then
      interpret resultname '= pvalue.1'
   else do
      interpret resultname "= '<absente>'"
      say 'INQ' propname 'erreur =' rcc
       call showerr rcc
      rcode = 8
   end
   return

/* ================================================================= */
/* Nettoyage general                                                 */
/* ================================================================= */
cleanup:
   if mhcree = 1 then call deletemh
   if mhputcree = 1 then call deleteputmh
   if hselouvert = 1 then call closeselector

   if hputouvert = 1 then do
      rcc2 = RXMQCLOS(hput,MQCO_NONE)
      say "CLOSE sortie cleanup =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else hputouvert = 0
   end

   if connecte = 1 then do
      rcc2 = RXMQDISC()
      say "DISC =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else connecte = 0
   end

   rcc = RXMQTERM()
   say 'TERM =' rcc
   if word(rcc,1) <> 0 then do
      call showerr rcc
      rcode = 8
   end

say "=============================================="
if rcode = 0 then
   say "TEST PASSED: HANDLE10"
else do
   say "TEST FAILED: HANDLE10"
   say "FIRST FAILURE =" firstFailure
end
say "=============================================="
exit rcode
showerr:
   parse arg errrcc
   if firstFailure = '' then firstFailure = errrcc
   say "LASTRC  =" RXMQ.LASTRC
   say "LASTCC  =" RXMQ.LASTCC
   say "LASTAC  =" RXMQ.LASTAC
   say "LASTMSG =" RXMQ.LASTMSG
return
