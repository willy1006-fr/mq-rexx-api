/* REXX */
/*
  * HANDLE4 - IBM MQ properties with multiple data types
 *
  * This sample deliberately follows the structure of HANDLE1:
  * CONN -> OPEN -> create MH1 -> SETMP -> PUT
  * -> create MH2 -> GET -> INQMP -> cleanup
 *
  * Properties tested:
  * usr.color     MQTYPE_STRING
  * usr.quantite    MQTYPE_INT32
  * usr.grandnombre MQTYPE_INT64
  * usr.prioritaire MQTYPE_BOOLEAN
  * usr.montant     MQTYPE_FLOAT64
  * usr.temperature MQTYPE_FLOAT32
 *
  * RXMQVTRACE = 'CONN OPEN PUT GET CLOSE DISC MH SMP IMP DMH'
 */
TRACE o

qmgr  = 'QM1'
qname = 'DEV.QUEUE.1'

mh1cree = 0
mh2cree = 0
ouvert  = 0
connecte = 0
rcode = 0

say "QMGR =" qmgr
say "QUEUE=" qname
say ""
/* --------------------------------------------------------------- */
/* 0. Initialization */
/* --------------------------------------------------------------- */
  rcc = rxmqinit()
  if word(rcc,1) /= 0      then do
   say time('l') 'initialization problem rc ==> ' rcc
   interpret 'msgerr = rxmq.rcmap.'word(rcc,1)
   say "                                           ==> "msgerr
   exit 8
   end

/* --------------------------------------------------------------- */
/* Connection */
/* --------------------------------------------------------------- */
rcc = RXMQCONN(qmgr)
say "CONN =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
connecte = 1

/* --------------------------------------------------------------- */
/* Open the queue for input and output */
/* --------------------------------------------------------------- */
iod1.OT = MQOT_Q
iod1.ON = qname
iod1.OM = ''

oo1 = MQOO_OUTPUT + MQOO_INPUT_SHARED + MQOO_FAIL_IF_QUIESCING

rcc = RXMQOPEN('iod1.',oo1,'h1','ood1.')
say "OPEN =" rcc " h1=" h1
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
ouvert = 1

/* --------------------------------------------------------------- */
/* Create the source message handle */
/* --------------------------------------------------------------- */
cmho1.OPT = MQCMHO_VALIDATE
rcc = RXMQMH('mh1','cmho1.')
say "MH1  =" rcc mh1
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
mh1cree = 1

/* Common descriptor for the usr.* application properties */
smpo1.OPT       = MQSMPO_NONE
pd1.OPT         = MQPD_NONE
pd1.SUPPORT     = MQPD_SUPPORT_OPTIONAL
pd1.CONTEXT     = MQPD_NO_CONTEXT
pd1.COPYOPTIONS = MQCOPY_DEFAULT

/* --------------------------------------------------------------- */
/* 1. STRING property */
/* --------------------------------------------------------------- */
rcc = RXMQSMP('mh1','smpo1.','usr.color','pd1.', MQTYPE_STRING,'red')
say "SMP usr.color     STRING  red   =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end

/* --------------------------------------------------------------- */
/* 2. INT32 property */
/* --------------------------------------------------------------- */
rcc = RXMQSMP('mh1','smpo1.','usr.quantite','pd1.',MQTYPE_INT32,25)
say "SMP usr.quantite    INT32   25      =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
/* --------------------------------------------------------------- */
/* 3. INT64 property */
/* --------------------------------------------------------------- */
rcc = RXMQSMP('mh1','smpo1.','usr.grandnombre','pd1.',MQTYPE_INT64,5000000000)
say "SMP usr.grandnombre INT64   5000000000 =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
/* --------------------------------------------------------------- */
/* 4. BOOLEAN property */
/* MQBOOL: 0 = FALSE, any other value = TRUE */
/* --------------------------------------------------------------- */
rcc = RXMQSMP('mh1','smpo1.','usr.prioritaire','pd1.', MQTYPE_BOOLEAN,1)
say "SMP usr.prioritaire BOOLEAN TRUE(1) =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end

/* --------------------------------------------------------------- */
/* 5. FLOAT64 property */
/* --------------------------------------------------------------- */
rcc = RXMQSMP('mh1','smpo1.','usr.montant','pd1.',MQTYPE_FLOAT64,123.45)
say "SMP usr.montant     FLOAT64 123.45  =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end

/* --------------------------------------------------------------- */
/* 6. FLOAT32 property */
/* --------------------------------------------------------------- */
rcc=RXMQSMP('mh1','smpo1.','usr.temperature','pd1.',MQTYPE_FLOAT32,12.5)
say "SMP usr.temperature FLOAT32 12.5  =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end

/* --------------------------------------------------------------- */
/* Message body */
/* --------------------------------------------------------------- */
d.1 = 'Test command: couleur=rouge quantite=25 montant=123.45'
d.0 = length(d.1)

/* MQMD for the PUT */
imd2.VER  = MQMD_VERSION_2
imd2.REP  = MQRO_NONE
imd2.MSG  = MQMT_DATAGRAM
imd2.EXP  = MQEI_UNLIMITED
imd2.FBK  = MQFB_NONE
imd2.ENC  = MQENC_NATIVE
imd2.CCSI = MQCCSI_Q_MGR
imd2.FORM = MQFMT_STRING
imd2.PRI  = MQPRI_PRIORITY_AS_Q_DEF
imd2.PER  = MQPER_PERSISTENCE_AS_Q_DEF

/* PMO: properties are supplied by handle mh1 */
ipmo2.VER     = MQPMO_VERSION_3
ipmo2.OPT = MQPMO_NO_SYNCPOINT+MQPMO_FAIL_IF_QUIESCING+MQPMO_DEFAULT_CONTEXT
ipmo2.TIME    = MQWI_UNLIMITED
ipmo2.OMH     = 0
ipmo2.NMH     = mh1
ipmo2.ACT     = MQACTP_NEW
ipmo2.PL      = 0

rcc = RXMQPUT(h1,'d.','imd2.','omd2.','ipmo2.','opmo2.')
say "PUT  =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end

/* The source handle is no longer required after the PUT */
dmho1.OPT = MQDMHO_NONE
rcc = RXMQDMH('mh1','dmho1.')
say "DMH mh1 =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
mh1cree = 0

/* --------------------------------------------------------------- */
/* Create the receiving handle */
/* --------------------------------------------------------------- */
cmho2.OPT = MQCMHO_VALIDATE
rcc = RXMQMH('mh2','cmho2.')
say "MH2  =" rcc mh2
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end
mh2cree = 1

/* GET: message properties are placed in mh2 */
msg2.0 = 8192

igmd2.VER  = MQMD_VERSION_2
igmd2.ENC  = MQENC_NATIVE
igmd2.CCSI = MQCCSI_Q_MGR
igmd2.FORM = MQFMT_NONE

igmo2.VER   = MQGMO_VERSION_4
igmo2.OPT   = MQGMO_NO_SYNCPOINT + MQGMO_WAIT +,
              MQGMO_FAIL_IF_QUIESCING
igmo2.WAIT  = 5000
igmo2.MOPT  = MQMO_NONE
igmo2.MH    = mh2

rcc = RXMQGET(h1,'msg2.','igmd2.','ogmd2.','igmo2.','ogmo2.')
say "GET  =" rcc
if word(rcc,1) <> 0 then do
   rcode = 8
   signal cleanup
end

say "Received body =" msg2.1
say ""

/* --------------------------------------------------------------- */
/* Read and verify the six properties individually */
/* --------------------------------------------------------------- */
impo1.OPT    = MQIMPO_NONE
impo1.RQENC  = MQENC_NATIVE
impo1.RQCCSI = MQCCSI_APPL

call verifprop 'usr.color',MQTYPE_STRING,'red'
call verifprop 'usr.quantite',MQTYPE_INT32,'25'
call verifprop 'usr.grandnombre',MQTYPE_INT64,'5000000000'
call verifprop 'usr.prioritaire',MQTYPE_BOOLEAN,'1'
call verifprop 'usr.montant',MQTYPE_FLOAT64,'123.45'
call verifprop 'usr.temperature',MQTYPE_FLOAT32,'12.5'

if rcode = 0 then do
   say ""
   say "=============================================="
   say "TEST PASSED: all six types were preserved"
   say "=============================================="
end
else do
   say ""
   say "=============================================="
   say "TEST FAILED: at least one property is incorrect"
   say "=============================================="
end

signal cleanup

/* --------------------------------------------------------------- */
/* Inquire a property and verify its type and value */
/* --------------------------------------------------------------- */
verifprop:
   parse arg nomatt,typeatt,valatt

   pvalue.0 = 4096
   pvalue.1 = ''
   pnameout = ''
   ptype    = ''

rcc = RXMQIMP('mh2','impo1.',nomatt,'pdout.','ptype','pvalue.','pnameout')

   say "IMP" nomatt "=" rcc

   if word(rcc,1) <> 0 then do
      say "FAILED: property inquiry failed"
      rcode = 8
      return
   end

   say "  name      =" pnameout
   say "  type     =" ptype "(expected" typeatt")"
   say "  longueur =" pvalue.0
   say "  value     =" pvalue.1 "(expected" valatt")"

   if ptype <> typeatt then do
      say "  FAILED: unexpected type"
      rcode = 8
   end
   else if pvalue.1 <> valatt then do
if typeatt = MQTYPE_FLOAT32 ! typeatt = MQTYPE_FLOAT64 then do
   if pvalue.1 = valatt + 0 then
      say "  OK: numerically equivalent value"
   else do
      say "  FAILED: unexpected value"
      rcode = 8
   end
end
else do
   if pvalue.1 = valatt then
      say "  OK"
   else do
      say "  FAILED: unexpected value"
      rcode = 8
   end
end
   end
   else
      say "  OK"

   say "----------------------------------------------"
return

/* --------------------------------------------------------------- */
/* Single cleanup path, including error cases */
/* --------------------------------------------------------------- */
cleanup:
   if mh2cree = 1 then do
      dmho2.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mh2','dmho2.')
      say "DMH mh2 =" rcc2
      mh2cree = 0
   end

   if mh1cree = 1 then do
      dmho1.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mh1','dmho1.')
      say "DMH mh1 =" rcc2
      mh1cree = 0
   end

   if ouvert = 1 then do
      rcc2 = RXMQCLOS(h1,0)
      say "CLOSE =" rcc2
      ouvert = 0
   end

   if connecte = 1 then do
      rcc2 = RXMQDISC()
      say "DISC  =" rcc2
      connecte = 0
   end

exit rcode
