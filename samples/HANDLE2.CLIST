/* REXX */
/*
RXMQVTRACE = 'CONN OPEN PUT GET CLOSE DISC MH SMP MBF BMH IMP DMH'
*/
TRACE o
mh1cree = 0
mh2cree = 0
ouvert = 0
connecte = 0
rcode = 0
firstFailure = ''
qmgr  = 'QM1'
qname = 'DEV.QUEUE.1'
say "QMGR =" qmgr
say "QUEUE=" qname
/* --------------------------------------------------------------- */
/* 0. Initialisation                                              */
/* --------------------------------------------------------------- */
  rcc = rxmqinit()
  if word(rcc,1) /= 0      then do
   say time('l') 'probleme initialisation rc ==> ' rcc
   call showerr rcc
   rcode = 8
   signal cleanup
   end
/* Connexion */
rcc = RXMQCONN(qmgr)
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
connecte = 1
say "CONN =" rcc
/* OPEN */
/* OPEN */
iod1.OT = MQOT_Q
iod1.ON = qname
iod1.OQM = ''
oo1 = MQOO_OUTPUT + MQOO_INPUT_SHARED + MQOO_FAIL_IF_QUIESCING
rcc = RXMQOPEN('iod1.', oo1, 'h1', 'ood1.')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
ouvert = 1
say "OPEN =" rcc " h1=" h1
/* MH source */
/* cmho1.OPT = MQCMHO_NONE*/
/* cmho1.OPT = MQCMHO_NO_VALIDATION */
cmho1.OPT = MQCMHO_VALIDATE
rcc = RXMQMH('mh1','cmho1.')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
mh1cree = 1
say "MH1 =" rcc mh1
/* Premi}re propri{t{ : usr.couleur = rouge */
smpo1.OPT = MQSMPO_NONE
pd1.OPT         = MQPD_NONE
pd1.SUPPORT     = MQPD_SUPPORT_OPTIONAL
pd1.CONTEXT     = MQPD_NO_CONTEXT
pd1.COPYOPTIONS = MQCOPY_DEFAULT
rcc = RXMQSMP('mh1','smpo1.','usr.couleur','pd1.',MQTYPE_STRING,'rouge')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
say "SMP usr.couleur =" rcc
/* Deuxi}me propri{t{ : usr.pays = France */
rcc = RXMQSMP('mh1','smpo1.','usr.pays','pd1.',MQTYPE_STRING,'France')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
say "SMP usr.pays =" rcc
/* Donn{es applicatives simples */
d.0 = 5
d.1 = 'hello'
/* MQMD PUT */
imd2.VER    = MQMD_VERSION_2
imd2.REP    = MQRO_NONE
imd2.MSG    = MQMT_DATAGRAM
imd2.EXP    = MQEI_UNLIMITED
imd2.FBK    = MQFB_NONE
imd2.ENC    = MQENC_NATIVE
imd2.CCSI = MQCCSI_Q_MGR
imd2.FORM   = MQFMT_STRING
imd2.PRI    = MQPRI_PRIORITY_AS_Q_DEF
imd2.PER    = MQPER_PERSISTENCE_AS_Q_DEF
/* PMO : le point important est NMH = mh1 */
ipmo2.VER = MQPMO_VERSION_3
ipmo2.OPT = MQPMO_NO_SYNCPOINT + MQPMO_FAIL_IF_QUIESCING+MQPMO_DEFAULT_CONTEXT
ipmo2.TIME    = MQWI_UNLIMITED
ipmo2.OMH = 0
ipmo2.NMH = mh1
ipmo2.ACT = MQACTP_NEW
ipmo2.PL = 0
rcc = RXMQPUT(h1, 'd.', 'imd2.', 'omd2.', 'ipmo2.', 'opmo2.')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
say "PUT =" rcc
/* MH1 peut être d{truit apr}s le PUT */
dmho1.OPT = MQDMHO_NONE
rcc = RXMQDMH('mh1','dmho1.')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
mh1cree = 0
say "DMH mh1 =" rcc
/* MH2 : handle qui recevra les propri{t{s au GET */
cmho2.OPT = MQCMHO_NONE
rcc = RXMQMH('mh2','cmho2.')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
mh2cree = 1
say "MH2 =" rcc mh2
/* Pr{paration GET */
msg2.0 = 8192
igmd2.VER   = MQMD_VERSION_2
igmd2.ENC   = MQENC_NATIVE
igmd2.CCSI = MQCCSI_Q_MGR
igmd2.FORM  = MQFMT_NONE
/* GMO : le point important est MH = mh2 */
igmo2.VER = MQGMO_VERSION_4
igmo2.OPT = MQGMO_NO_SYNCPOINT + MQGMO_WAIT + MQGMO_FAIL_IF_QUIESCING
igmo2.WAIT = 5000
igmo2.MOPT  = MQMO_NONE
igmo2.MH = mh2
rcc = RXMQGET(h1, 'msg2.', 'igmd2.', 'ogmd2.', 'igmo2.', 'ogmo2.')
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
say "GET =" rcc
say "msg2.0           =" msg2.0
say "msg2.1 length =" length(msg2.1)
say "msg2.1           =" msg2.1
/* IMP : lecture de la propri{t{ directement depuis mh2 */
/* Énum{ration de toutes les propri{t{s usr.* */
impo1.OPT    = MQIMPO_INQ_FIRST
impo1.RQENC  = MQENC_NATIVE
impo1.RQCCSI = MQCCSI_APPL
pname = 'usr.%'
say "Enumeration des proprietes correspondant a" pname
do forever
  pvalue.1 = ''
  pvalue.0 = 4096
  pnameout = ''
  ptype    = ''
rcc = RXMQIMP('mh2','impo1.',pname,'pdout.','ptype','pvalue.','pnameout')
   if word(rcc,1) <> 0 then do
      if word(rcc,1) = MQCC_FAILED &,
         RXMQ.LASTCC = MQCC_FAILED &,
         RXMQ.LASTAC = MQRC_PROPERTY_NOT_AVAILABLE then leave
      call showerr rcc
      rcode = 8
      signal cleanup
   end
  say "Nom    =" pnameout
  say "Type   =" ptype
  say "Valeur =" pvalue.1
  say "rcc=" rcc
  say "------------------------------"
  impo1.OPT = MQIMPO_INQ_NEXT
end
say "Fin de l'enumeration"
cleanup:
   if mh2cree = 1 then do
      dmho2.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mh2','dmho2.')
      say "DMH mh2 =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else mh2cree = 0
   end
   if mh1cree = 1 then do
      dmho1.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mh1','dmho1.')
      say "DMH mh1 =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else mh1cree = 0
   end
   if ouvert = 1 then do
      rcc2 = RXMQCLOS(h1,0)
      say "CLOSE =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else ouvert = 0
   end
   if connecte = 1 then do
      rcc2 = RXMQDISC()
      say "DISC =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else connecte = 0
   end
say "=============================================="
if rcode = 0 then
   say "TEST PASSED: HANDLE2"
else do
   say "TEST FAILED: HANDLE2"
   say "FIRST FAILURE =" firstFailure
end
say "=============================================="
exit rcode
showerr:
   parse arg errrcc
   if firstFailure = '' then firstFailure = errrcc
   say "LASTRC  =" RXMQ.LASTRC
   say "LASTCC  =" RXMQ.LASTCC
   say "LASTAC  =" RXMQ.LASTAC
   say "LASTMSG =" RXMQ.LASTMSG
return
