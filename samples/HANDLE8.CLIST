/* REXX */
/*
 * HANDLE8 - Conversion Message Handle / buffer MQRFH2
 *
 *   CONN
 *   -> creation MH1
 *   -> SETMP de plusieurs proprietes dans MH1
 *   -> MQMHBUF : MH1 vers buffer MQRFH2
 *   -> creation MH2
 *   -> MQBUFMH : buffer MQRFH2 vers MH2
 *   -> verification des proprietes reconstruites dans MH2
 *   -> nettoyage
 */
TRACE o
qmgr  = 'QM1'
mh1cree  = 0
mh2cree  = 0
connecte = 0
rcode    = 0
firstFailure = ''
say "QMGR =" qmgr
say ""
/* --------------------------------------------------------------- */
/* 0. Initialisation                                              */
/* --------------------------------------------------------------- */
  rcc = rxmqinit()
  if word(rcc,1) /= 0      then do
   say time('l') 'probleme initialisation rc ==> ' rcc
   call showerr rcc
   rcode = 8
   signal cleanup
   end
/* --------------------------------------------------------------- */
/* Connexion                                                       */
/* --------------------------------------------------------------- */
rcc = RXMQCONN(qmgr)
say "CONN =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
connecte = 1
/* --------------------------------------------------------------- */
/* Creation du message handle MH1                                  */
/* --------------------------------------------------------------- */
cmho1.OPT = MQCMHO_VALIDATE
rcc = RXMQMH('mh1','cmho1.')
say "MH1 =" rcc mh1
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
mh1cree = 1
/* --------------------------------------------------------------- */
/* Definition des proprietes dans MH1                              */
/* --------------------------------------------------------------- */
smpo1.OPT        = MQSMPO_NONE
pd1.OPT          = MQPD_NONE
pd1.SUPPORT      = MQPD_SUPPORT_OPTIONAL
pd1.CONTEXT      = MQPD_NO_CONTEXT
pd1.COPYOPTIONS  = MQCOPY_DEFAULT
rcc=RXMQSMP('mh1','smpo1.','usr.couleur','pd1.',MQTYPE_STRING,'bleu')
say "SMP usr.couleur     =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
rcc=RXMQSMP('mh1','smpo1.','usr.quantite','pd1.',MQTYPE_INT32,25)
say "SMP usr.quantite    =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
rcc=RXMQSMP('mh1','smpo1.','usr.prioritaire','pd1.',MQTYPE_BOOLEAN,1)
say "SMP usr.prioritaire =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
rcc=RXMQSMP('mh1','smpo1.','usr.montant','pd1.',MQTYPE_FLOAT64,123.45)
say "SMP usr.montant     =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
rcc=RXMQSMP('mh1','smpo1.','usr.client','pd1.',MQTYPE_STRING,'IBM')
say "SMP usr.client      =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
/* --------------------------------------------------------------- */
/* Conversion du message handle MH1 vers un buffer MQRFH2          */
/* --------------------------------------------------------------- */
mhbo1.OPT = MQMHBO_PROPERTIES_IN_MQRFH2
mhbo1.VER = MQMHBO_VERSION_1
md1.VER  = MQMD_VERSION_2
md1.REP  = MQRO_NONE
md1.MSG  = MQMT_DATAGRAM
md1.EXP  = MQEI_UNLIMITED
md1.FBK  = MQFB_NONE
md1.ENC  = MQENC_NATIVE
md1.CCSI = MQCCSI_Q_MGR
md1.FORM = MQFMT_STRING
md1.PRI  = MQPRI_PRIORITY_AS_Q_DEF
md1.PER  = MQPER_PERSISTENCE_AS_Q_DEF
pnam = '%'
buf  = ''
blen = 0
say ""
say "=============================================="
say "MQMHBUF : MH1 VERS BUFFER MQRFH2"
say "=============================================="
rcc = RXMQMBF('mh1','mhbo1.',pnam,'md1.','buf',8192,'blen')
say "MBF =" rcc
say "MD.CCSI   =" md1.CCSI
say "MD.ENC    =" md1.ENC
say "MD.FORM   =" md1.FORM
say "buf length=" length(buf)
say "blen      =" blen
say "buf hex   =" c2x(substr(buf,1,64))
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
if blen = 0 then do
   say "KO : aucun buffer MQRFH2 retourne"
   if firstFailure = '' then
      firstFailure = 'Aucun buffer MQRFH2 retourne'
   rcode = 8
   signal cleanup
end
/* --------------------------------------------------------------- */
/* Creation du message handle MH2                                  */
/* --------------------------------------------------------------- */
cmho2.OPT = MQCMHO_VALIDATE
rcc = RXMQMH('mh2','cmho2.')
say ""
say "MH2 =" rcc mh2
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
mh2cree = 1
/* --------------------------------------------------------------- */
/* Conversion du buffer MQRFH2 vers le message handle MH2          */
/* --------------------------------------------------------------- */
bmho1.OPT = MQBMHO_NONE
bmhbuf.0 = blen
bmhbuf.1 = buf
say ""
say "=============================================="
say "MQBUFMH : BUFFER MQRFH2 VERS MH2"
say "=============================================="
rcc = RXMQBMH('mh2','bmho1.','md1.','bmhbuf.')
say "BMH =" rcc
if word(rcc,1) <> 0 then do
   call showerr rcc
   rcode = 8
   signal cleanup
end
/* --------------------------------------------------------------- */
/* Options MQINQMP                                                 */
/* --------------------------------------------------------------- */
impo1.OPT    = MQIMPO_NONE + MQIMPO_CONVERT_VALUE
impo1.RQENC  = MQENC_INTEGER_NORMAL + MQENC_DECIMAL_NORMAL +,
                MQENC_FLOAT_IEEE_NORMAL
impo1.RQCCSI = MQCCSI_APPL
handleinq = 'mh2'
/* --------------------------------------------------------------- */
/* Verification des proprietes reconstruites dans MH2              */
/* --------------------------------------------------------------- */
say ""
say "=============================================="
say "VERIFICATION DES PROPRIETES DANS MH2"
say "=============================================="
say ""
call verifprop 'usr.couleur',MQTYPE_STRING,'bleu'
call verifprop 'usr.quantite',MQTYPE_INT32,'25'
call verifprop 'usr.prioritaire',MQTYPE_BOOLEAN,'1'
call verifprop 'usr.montant',MQTYPE_FLOAT64,'123.45'
call verifprop 'usr.client',MQTYPE_STRING,'IBM'
/* --------------------------------------------------------------- */
/* Bilan                                                           */
/* --------------------------------------------------------------- */
say ""
signal cleanup
/* --------------------------------------------------------------- */
/* Verification d'une propriete                                    */
/* --------------------------------------------------------------- */
verifprop:
   parse arg nomatt,typeatt,valatt
   pvalue.0 = 4096
   pvalue.1 = ''
   pnameout = ''
   ptype    = ''
   rcc=RXMQIMP(handleinq,'impo1.',nomatt,'pdout.','ptype','pvalue.','pnameout')
   say "Verification de" nomatt
   say "  IMP              =" rcc
   if word(rcc,1) <> 0 then do
      call showerr rcc
      say "  KO : propriete absente ou erreur"
      rcode = 8
      say "----------------------------------------------"
      return
   end
   say "  Nom retourne     =" pnameout
   say "  Type retourne    =" ptype
   say "  Type attendu     =" typeatt
   say "  Valeur retournee =" pvalue.1
   say "  Valeur attendue  =" valatt
   if ptype <> typeatt then do
      say "  KO : type inattendu"
      if firstFailure = '' then
         firstFailure = 'Type inattendu :' nomatt
      rcode = 8
   end
   else if pvalue.1 <> valatt then do
      say "  KO : valeur inattendue"
      if firstFailure = '' then
         firstFailure = 'Valeur inattendue :' nomatt
      rcode = 8
   end
   else
      say "  OK : propriete reconstruite"
   say "----------------------------------------------"
return
/* --------------------------------------------------------------- */
/* Nettoyage unique                                                */
/* --------------------------------------------------------------- */
cleanup:
   if mh2cree = 1 then do
      dmho2.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mh2','dmho2.')
      say "DMH mh2 =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else mh2cree = 0
   end
   if mh1cree = 1 then do
      dmho1.OPT = MQDMHO_NONE
      rcc2 = RXMQDMH('mh1','dmho1.')
      say "DMH mh1 =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else mh1cree = 0
   end
   if connecte = 1 then do
      rcc2 = RXMQDISC()
      say "DISC =" rcc2
      if word(rcc2,1) <> 0 then do
         call showerr rcc2
         rcode = 8
      end
      else connecte = 0
   end
say "=============================================="
if rcode = 0 then
   say "TEST PASSED: HANDLE8"
else do
   say "TEST FAILED: HANDLE8"
   say "FIRST FAILURE =" firstFailure
end
say "=============================================="
exit rcode
showerr:
   parse arg errrcc
   if firstFailure = '' then firstFailure = errrcc
   say "LASTRC  =" RXMQ.LASTRC
   say "LASTCC  =" RXMQ.LASTCC
   say "LASTAC  =" RXMQ.LASTAC
   say "LASTMSG =" RXMQ.LASTMSG
return
