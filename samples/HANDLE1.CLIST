/* REXX */
/*
RXMQVTRACE = 'CONN OPEN PUT GET CLOSE DISC MH SMP MBF BMH IMP DMH'
*/
TRACE o
qmgr  = 'QM1'
qname = 'DEV.QUEUE.1'
say "QMGR =" qmgr
say "QUEUE=" qname
/* --------------------------------------------------------------- */
/* 0. Initialization */
/* --------------------------------------------------------------- */
  rcc = rxmqinit()
  if word(rcc,1) /= 0      then do
   say time('l') 'initialization problem rc ==> ' rcc
   interpret 'msgerr = rxmq.rcmap.'word(rcc,1)
   say "                                           ==> "msgerr
   exit 8
   end
/* Connection */
rcc = RXMQCONN(qmgr)
say "CONN =" rcc
/* OPEN */
/* OPEN */
iod1.OT = MQOT_Q
iod1.ON = qname
iod1.OM = ''
oo1 = MQOO_OUTPUT + MQOO_INPUT_SHARED + MQOO_FAIL_IF_QUIESCING
rcc = RXMQOPEN('iod1.', oo1, 'h1', 'ood1.')
say "OPEN =" rcc " h1=" h1
/* MH source */
/* cmho1.OPT = MQCMHO_NONE */
/* cmho1.OPT = MQCMHO_NO_VALIDATION */
cmho1.OPT = MQCMHO_VALIDATE
rcc = RXMQMH('mh1','cmho1.')
say "MH1 =" rcc mh1
/* Property usr.color = red */
smpo1.OPT = MQSMPO_NONE
pd1.OPT = MQPD_NONE
pd1.SUPPORT = MQPD_SUPPORT_OPTIONAL
pd1.CONTEXT = MQPD_NO_CONTEXT
pd1.COPYOPTIONS = MQCOPY_DEFAULT
rcc = RXMQSMP('mh1','smpo1.','usr.color','pd1.',MQTYPE_STRING,'red')
say "SMP =" rcc
if word(rcc,1) <> 0 then signal cleanup_mh1
/* Simple application data */
d.0 = 5
d.1 = 'hello'
/* MQMD PUT */
imd2.VER    = MQMD_VERSION_2
imd2.REP    = MQRO_NONE
imd2.MSG    = MQMT_DATAGRAM
imd2.EXP    = MQEI_UNLIMITED
imd2.FBK    = MQFB_NONE
imd2.ENC    = MQENC_NATIVE
imd2.CCSI = MQCCSI_Q_MGR
imd2.FORM   = MQFMT_STRING
imd2.PRI    = MQPRI_PRIORITY_AS_Q_DEF
imd2.PER    = MQPER_PERSISTENCE_AS_Q_DEF
/* PMO: the important field is NMH = mh1 */
ipmo2.VER = MQPMO_VERSION_3
ipmo2.OPT = MQPMO_NO_SYNCPOINT + MQPMO_FAIL_IF_QUIESCING+MQPMO_DEFAULT_CONTEXT
ipmo2.TIME    = MQWI_UNLIMITED
ipmo2.OMH = 0
ipmo2.NMH = mh1
ipmo2.ACT = MQACTP_NEW
ipmo2.PL = 0
rcc = RXMQPUT(h1, 'd.', 'imd2.', 'omd2.', 'ipmo2.', 'opmo2.')
say "PUT =" rcc
if word(rcc,1) <> 0 then signal cleanup_mh1
/* MH1 can be deleted after the PUT */
dmho1.OPT = MQDMHO_NONE
rcc = RXMQDMH('mh1','dmho1.')
say "DMH mh1 =" rcc
/* MH2: handle that receives the properties during GET */
cmho2.OPT = MQCMHO_NONE
rcc = RXMQMH('mh2','cmho2.')
say "MH2 =" rcc mh2
if word(rcc,1) <> 0 then signal cleanup_close
/* Prepare the GET */
msg2.0 = 8192
igmd2.VER   = MQMD_VERSION_2
igmd2.ENC   = MQENC_NATIVE
igmd2.CCSI = MQCCSI_Q_MGR
igmd2.FORM  = MQFMT_NONE
/* GMO: the important field is MH = mh2 */
igmo2.VER = MQGMO_VERSION_4
igmo2.OPT = MQGMO_NO_SYNCPOINT + MQGMO_WAIT + MQGMO_FAIL_IF_QUIESCING
igmo2.WAIT = 5000
igmo2.MOPT  = MQMO_NONE
igmo2.MH = mh2
rcc = RXMQGET(h1, 'msg2.', 'igmd2.', 'ogmd2.', 'igmo2.', 'ogmo2.')
say "GET =" rcc
say "msg2.0           =" msg2.0
say "msg2.1 length =" length(msg2.1)
say "msg2.1           =" msg2.1
if word(rcc,1) <> 0 then signal cleanup_mh2
/* IMP: inquire the property directly from mh2 */
impo1.OPT = MQIMPO_NONE
impo1.RQENC = MQENC_NATIVE
impo1.RQCCSI = MQCCSI_APPL
pname = 'usr.color'
pvalue.1 = ''
pvalue.0 = 4096
rcc = RXMQIMP('mh2','impo1.',pname,'pdout.','ptype','pvalue.','pnameout')
say "IMP        =" rcc
say "ptype      =" ptype
say "pvalue     =" pvalue.1
say "datalength =" pvalue.0
say "pnameout   =" pnameout
if pvalue.1 = 'red' then
  say "OK: property usr.color = red"
else
  say "FAILED: unexpected property value"
/* Normal cleanup */
cleanup_mh2:
  dmho2.OPT = MQDMHO_NONE
  rcc = RXMQDMH('mh2','dmho2.')
  say "DMH mh2 =" rcc
cleanup_close:
  rcc = RXMQCLOS(h1,0)
  say "CLOSE =" rcc
cleanup_disc:
  rcc = RXMQDISC()
  say "DISC =" rcc
exit 0
cleanup_mh1:
  dmho1.OPT = MQDMHO_NONE
  rcc = RXMQDMH('mh1','dmho1.')
  say "DMH mh1 =" rcc
  signal cleanup_close
